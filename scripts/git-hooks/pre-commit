#!/bin/sh
# Pre-commit check for this repository: links, anchors, maturity levels, structure, versions, confidentiality.
# Reads your local deny list (.git/info/deny-list.txt) automatically. Install once per clone:
#   git config core.hooksPath scripts/git-hooks
# Bypass in an emergency only: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 1
log=$(mktemp) || exit 1
python3 "$root/scripts/check_repo.py" >"$log" 2>&1
status=$?
if [ $status -ne 0 ]; then
    grep -E "^ERROR|error\(s\)" "$log" >&2
    echo "pre-commit: scripts/check_repo.py failed; fix the errors above before committing." >&2
fi
rm -f "$log"
exit $status
